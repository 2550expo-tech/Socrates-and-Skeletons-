{
  "expo": {
    "name": "MyPay",
    "slug": "mypay",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.socratesandskeletons.mypay",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "MyPay ตรวจรูปในแกลเลอรีเพื่อหาสลิปโอนเงินและบันทึกรายการให้อัตโนมัติ"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E3B2C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.socratesandskeletons.mypay",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "MyPay",
      "themeColor": "#0E3B2C",
      "backgroundColor": "#F2F5F1"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "MyPay ตรวจรูปในแกลเลอรีเพื่อหาสลิปโอนเงินและบันทึกรายการให้อัตโนมัติ",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "เลือกรูปสลิปเพื่อให้ MyPay อ่านรายการ",
          "cameraPermission": false,
          "microphonePermission": "MyPay ใช้ไมโครโฟนเมื่อคุณแตะปุ่มไมค์เพื่อพูดจดรายการ เช่น “ข้าว 50 บาท”"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E3B2C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MyPay ใช้ไมโครโฟนเมื่อคุณแตะปุ่มไมค์เพื่อพูดจดรายการ เช่น “ข้าว 50 บาท”",
          "speechRecognitionPermission": "MyPay แปลงเสียงที่คุณพูดเป็นรายการรายรับรายจ่าย",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MyPayQuick",
              "label": "MyPay · วันนี้",
              "description": "ยอดใช้วันนี้ เงินพอใช้อีกกี่วัน และปุ่มลัด เลือกสลิป พูด และ +",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/quick.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "scheme": "mypay",
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    },
    "owner": "expokler"
  }
}
